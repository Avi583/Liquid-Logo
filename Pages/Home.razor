@page "/"
@using Avi583Logo.Physics
@* Logic: Home.razor.cs (page plumbing) and Physics/CardPhysics.cs (simulation) *@

<PageTitle>Avi583</PageTitle>

<div class="stage"
     @onpointermove="OnPointerMove"
     @onpointerup="OnPointerUp"
     @onpointercancel="OnPointerUp"
     @onpointerleave="OnPointerUp">

    <div class="hint">
        @(body.Pinned
            ? "Drag the card to swing and stretch it  ·  Click the pin to pull it out"
            : "Grab and throw the card  ·  Press \"Pin it back\" to reset")
    </div>

    @if (ready)
    {
        @* Hole left in the cork board after the pin is pulled *@
        @if (!body.Pinned)
        {
            <div class="pinhole" style="@($"left:{F(body.HoleX)}px;top:{F(body.HoleY)}px")"></div>
        }

        @* The single object: GitHub logo + name *@
        <div class="card @(body.Mode != DragMode.None ? "grabbing" : "")"
             style="@CardStyle"
             @onpointerdown="OnCardPointerDown"
             @onpointerdown:preventDefault="true">
            <img class="logo" src="images/github-mark.svg" alt="GitHub logo" draggable="false"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
            <div class="logo-missing">add<br />images/github-mark.svg</div>
            <div class="name">Avi583</div>
        </div>

        @if (body.Pinned)
        {
            <button class="pin" title="Click to pull the pin out"
                    style="@($"left:{F(body.PinX)}px;top:{F(body.PinY)}px")"
                    @onclick="Unpin"></button>
        }
        else
        {
            @* The pulled pin tumbles away (CSS animation) *@
            <div @key="dropCount" class="pin falling"
                 style="@($"left:{F(body.HoleX)}px;top:{F(body.HoleY)}px;--fall:{F(body.ViewH - body.HoleY + 60)}px")"></div>
        }
    }

    <div class="toolbar">
        @if (body.Pinned)
        {
            <button @onclick="Unpin">Remove pin</button>
        }
        else
        {
            <button @onclick="Repin">Pin it back</button>
        }
        <button @onclick="ResetStretch">Reset stretch</button>
        <label>
            <input type="checkbox" checked="@body.Elastic" @onchange="ToggleElastic" />
            Snap back
        </label>
    </div>
</div>
